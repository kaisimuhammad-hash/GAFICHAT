{
  "name": "nexadesk",
  "version": "1.6.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "NexaDesk",
  "description": "Dashboard multi-akun WhatsApp dengan balasan AI Gemini, tiket, dan kontrol bot/manual.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch --watch-path=server server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "start:lan": "cross-env NODE_ENV=production HOST=0.0.0.0 node server/index.js",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "demo:seed": "node scripts/seed-demo.js"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "id.nexadesk.app",
    "productName": "NexaDesk",
    "artifactName": "NexaDesk-${version}-portable.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.24",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^1.72.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
